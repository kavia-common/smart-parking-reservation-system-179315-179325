# React frontend environment variables
# Copy this file to .env and fill values. Do NOT commit your real .env.

# Frontend public URL used for auth redirects (optional)
REACT_APP_SITE_URL=http://localhost:3000

# Firebase web app public configuration
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-firebase-app-id
# Optional: Firestore emulator settings (for local dev)
# REACT_APP_FIREBASE_EMULATOR_HOST=localhost
# REACT_APP_FIREBASE_EMULATOR_FIRESTORE_PORT=8080
# REACT_APP_FIREBASE_EMULATOR_AUTH_PORT=9099

# Backend API base URL
REACT_APP_API_BASE=http://localhost:3001
